-- allium: 3
-- controlled-ontology.allium

-- Scope: Centrally governed semantic types for Vera content
-- Includes: Composable types, pending classification suggestions, curator
--   confirmation, human correction, and a deliberately small starter ontology
-- Excludes:
--   - Automated classification models and confidence algorithms
--   - Free-form tags
--   - Query syntax and visual presentation
--   - Domain-specific lifecycle rules for individual semantic types

use "./core.allium" as core

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum AssignmentStatus { suggested | confirmed | rejected }

-- En qué estado está una palabra del vocabulario.
--
-- Un vocabulario que sólo crece es un vocabulario que nadie limpia, y uno que se
-- reescribe en silencio deja el corpus diciendo cosas que su autor no dijo. Por
-- eso una palabra se propone antes de regir, y se deprecia en vez de borrarse:
-- lo que ya se clasificó con ella sigue siendo legible.
enum VocabularyStatus { proposed | approved | deprecated }

-- Cómo se relaciona un concepto con otro. Los nombres son los de SKOS, que
-- lleva décadas resolviendo esto y con el que conviene poder hablar.
enum ConceptRelationKind { broader | related | exact_match | close_match }

-- Una migración se propone, se mira y sólo entonces corre.
enum MigrationStatus { previewed | applied | discarded }

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

entity Ontology {
    graph: core/Graph
    types: SemanticType with ontology = this
    concepts: Concept with ontology = this
    relations: RelationDefinition with ontology = this
    assignments: TypeAssignment with ontology = this
}

entity SemanticType {
    ontology: Ontology
    name: String
    description: String
    property_definitions: PropertyDefinition with semantic_type = this
}

-- De qué trata algo, que no es lo mismo que qué clase de cosa es.
--
-- Una página puede ser una Publicación —eso es su tipo— y tratar sobre
-- accesibilidad cognitiva y sobre pictogramas —eso son sus conceptos. Confundir
-- las dos cosas es lo que hace que una etiqueta libre termine significando a
-- ratos «esto es» y a ratos «esto habla de», y que no se pueda consultar
-- ninguna de las dos con confianza.
--
-- Los tags libres del corpus no se tiran: son la evidencia de qué conceptos
-- hacían falta. Se conservan como fuente y su normalización se propone.
entity Concept {
    ontology: Ontology
    -- El nombre por el que se le llama, uno solo.
    preferred_label: String
    definition: String
    -- Los demás nombres del mismo concepto. Absorbe mayúsculas, idioma y
    -- variantes ortográficas sin multiplicar identidades: el corpus ya escribe
    -- `lang` y `language`, `status` y `Estado`, y son uno.
    alt_labels: Set<String>
    status: VocabularyStatus
}

-- Que un concepto sea más amplio, más estrecho o vecino de otro.
--
-- No se fuerza una jerarquía única: el conocimiento de alguien no es un árbol, y
-- obligarlo a serlo hace que la mitad de las cosas cuelguen del sitio equivocado.
entity ConceptRelation {
    from: Concept
    to: Concept
    kind: ConceptRelationKind
}

-- Una relación entre entidades, con dirección.
--
-- Se guarda en una sola dirección y su inversa se deriva: `Persona member-of
-- Organización` permite preguntar por los miembros de una organización sin
-- mantener dos listas que puedan discrepar. Una relación derivada es un índice
-- reconstruible, nunca un dato que alguien edite.
entity RelationDefinition {
    ontology: Ontology
    name: String
    description: String
    -- Desde qué tipo sale y hacia cuáles puede apuntar.
    domain: SemanticType
    range: Set<SemanticType>
    -- Cuántas admite. Una relación multivaluada necesita cardinalidad de verdad
    -- en el modelo: comprimir varias en una cadena separada por comas convierte
    -- una consulta en una búsqueda de texto.
    multiple: Boolean
    -- El nombre de la inversa, cuando tiene sentido preguntar al revés. No se
    -- almacena: se calcula.
    derived_inverse: String?
    status: VocabularyStatus
}

-- Una relación afirmada entre dos cosas concretas.
entity RelationAssertion {
    definition: RelationDefinition
    from: core/Page
    to: core/Page
    status: AssignmentStatus
    asserted_by: core/Participant
}

-- Una reescritura de citas, mirada antes de correr.
--
-- Existe como entidad y no como un botón porque hay un momento entre proponerla
-- y aplicarla en el que alguien tiene que poder verla: qué cambia, dónde y
-- cuánto. Ese momento es la diferencia entre una migración y un accidente.
entity CitationMigration {
    ontology: Ontology
    -- Qué se deja de escribir y qué se escribe en su lugar.
    from_label: String
    to_label: String
    -- Los bloques que cambiarían y cómo quedarían, calculados antes de tocar
    -- nada. Es lo que se enseña.
    affected: Set<AffectedCitation>
    status: MigrationStatus
    proposed_by: core/Participant
    applied_by: core/Participant?
    applied_at: Timestamp?
}

entity AffectedCitation {
    migration: CitationMigration
    block: core/Block
    -- El texto tal como está y tal como quedaría, entero: se compara lo que hay
    -- con lo que habría, no un resumen de la diferencia.
    current: String
    rewritten: String
}

entity PropertyDefinition {
    semantic_type: SemanticType
    name: String
    description: String
    required: Boolean
}

entity TypeAssignment {
    ontology: Ontology
    semantic_type: SemanticType
    page: core/Page?
    block: core/Block?
    status: AssignmentStatus
    rationale: String
    suggested_by: core/Participant
    decided_by: core/Participant?
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule SuggestPageSemanticType {
    when: SuggestPageType(participant, ontology, semantic_type, page, rationale)

    requires: semantic_type.ontology = ontology
    requires: page.graph = ontology.graph

    ensures: TypeAssignment.created(
        ontology: ontology,
        semantic_type: semantic_type,
        page: page,
        block: null,
        status: suggested,
        rationale: rationale,
        suggested_by: participant,
        decided_by: null
    )
}

rule SuggestBlockSemanticType {
    when: SuggestBlockType(participant, ontology, semantic_type, block, rationale)

    requires: semantic_type.ontology = ontology
    requires: block.page.graph = ontology.graph

    ensures: TypeAssignment.created(
        ontology: ontology,
        semantic_type: semantic_type,
        page: null,
        block: block,
        status: suggested,
        rationale: rationale,
        suggested_by: participant,
        decided_by: null
    )
}

-- Procesar una página: leerla y decir qué se ve en ella.
--
-- Un solo acto, deliberado y sobre una página concreta, del que salen
-- proposiciones de tres clases —qué es la página, qué nombra, y a qué apuntan
-- sus enlaces— y ninguna decisión. Es la misma forma que la voz: la máquina
-- propone, la persona declara.
--
-- Deliberado y no automático por dos razones. La primera es que clasificar de
-- oficio llenaría el corpus de sugerencias que nadie pidió y que hay que
-- desestimar una por una, y una bandeja que sólo crece se deja de mirar. La
-- segunda está abajo, en @invariant ReachingOutIsAnOutwardAct.
rule ParticipantProcessesAPage {
    when: ProcessPage(participant, ontology, page)

    let membership = core/Membership{graph: ontology.graph, participant: participant}

    requires: exists membership
    requires: membership.status = active

    ensures:
        for finding in readings_of(page):
            TypeAssignment.created(
                ontology: ontology,
                semantic_type: finding.semantic_type,
                page: page,
                block: null,
                status: suggested,
                rationale: finding.rationale,
                suggested_by: participant,
                decided_by: null
            )

    @invariant ProcessingProposesAndNothingMore
        -- Processing writes no content, changes no property and settles no type.
        -- What it leaves are suggestions, and a page processed and then ignored
        -- is exactly the page it was.

    @invariant ReachingOutIsAnOutwardAct
        -- Resolving what a link points at means asking the server that holds it,
        -- and asking tells that server that someone here is reading about this.
        -- A sovereign memory does not make that request behind its owner's back:
        -- it happens because they asked for it, on the page they asked it for,
        -- and what was requested is recorded.

    @invariant TheModelIsLocalOrThereIsNone
        -- The model that reads the page runs on this machine, like the one that
        -- transcribes voice. A corpus does not leave to be understood. Where no
        -- local model is available, processing does the part that needs none and
        -- says plainly which part it could not do.
}

-- Decir que una cosa se relaciona con otra.
--
-- Se guarda en la dirección canónica de la definición y nada más: preguntar al
-- revés lo responde un índice. Como todo lo que propone una máquina, nace
-- sugerida; a diferencia de un tipo, la puede escribir una persona directamente
-- porque es una afirmación sobre el mundo y no sobre el vocabulario.
rule AssertRelation {
    when: AssertRelated(participant, ontology, definition, from, to)

    requires: definition.ontology = ontology
    requires: definition.status != deprecated
    -- Una relación que sale de donde no puede salir no es un error del corpus:
    -- casi siempre es una ontología que se quedó corta. Se declara igual y la
    -- discrepancia queda a la vista, en vez de perderse la afirmación.
    requires: exists from
    requires: exists to

    ensures: RelationAssertion.created(
        definition: definition,
        from: from,
        to: to,
        status: suggested,
        asserted_by: participant
    )
}

-- Que un concepto sea más amplio que otro, o vecino suyo.
rule RelateConcepts {
    when: RelateConcept(participant, ontology, from, to, kind)

    requires: from.ontology = ontology
    requires: to.ontology = ontology
    requires: from != to

    ensures: ConceptRelation.created(from: from, to: to, kind: kind)
}

-- Fusionar dos conceptos que resultaron ser uno.
--
-- Pasa constantemente y no es un descuido: uno escribe `lang` un martes y
-- `language` un jueves, y ninguno de los dos estaba mal cuando se escribió. El
-- vocabulario se descubre usándolo.
--
-- La fusión es un acto de vocabulario y ocurre entera y al instante: el nombre
-- del absorbido pasa a ser un alias del que queda, así que todo lo que lo
-- nombraba —consultas, asignaciones, relaciones— apunta al mismo sitio desde ya.
-- Nada del texto se toca aquí. Reescribir las citas es otra cosa, viene después
-- y se pide aparte: ver rule MigrateCitations.
rule MergeConcepts {
    when: MergeConcept(participant, ontology, absorbed, surviving)

    requires: absorbed.ontology = ontology
    requires: surviving.ontology = ontology
    requires: absorbed != surviving
    requires: participant.kind = human

    ensures:
        -- El nombre del absorbido sobrevive como alias. Es lo que hace que una
        -- cita escrita hace dos años siga resolviendo sin haberla tocado.
        surviving.alt_labels = surviving.alt_labels + absorbed.preferred_label + absorbed.alt_labels
        absorbed.status = deprecated
        for assignment in TypeAssignments where concept = absorbed:
            assignment.concept = surviving
        for relation in ConceptRelations where from = absorbed:
            relation.from = surviving
        for relation in ConceptRelations where to = absorbed:
            relation.to = surviving

    @invariant AMergeIsReversibleUntilTheTextMoves
        -- Fusionar no destruye el concepto absorbido: lo deprecia y le conserva
        -- sus nombres. Deshacerlo es devolverle el estado y separar los alias,
        -- y mientras nadie haya reescrito una cita eso basta.

    @invariant WhatWasWrittenStaysWritten
        -- Fusionar no cambia una palabra del corpus. Lo que un participante
        -- escribió sigue diciendo lo que escribió, y lo que cambia es a qué
        -- resuelve — que es una afirmación sobre el vocabulario, no sobre el
        -- texto de nadie.
}

-- Reescribir las citas para que el texto diga lo que el vocabulario ya sabe.
--
-- Un acto aparte, posterior y opcional. Vera funciona sin él: la fusión ya hizo
-- que todo resuelva. Esto existe porque un corpus donde la mitad de los enlaces
-- dicen `language` y la otra mitad `lang` es un corpus que se lee mal aunque
-- consulte bien, y porque quien escribe merece que su texto se parezca a lo que
-- ha decidido.
rule MigrateCitations {
    when: MigrateCitationsTo(participant, migration)

    requires: participant.kind = human
    requires: migration.status = previewed

    ensures:
        for citation in migration.affected:
            core/ParticipantSubmits(
                participant: participant,
                graph: migration.ontology.graph,
                origin_id: migration.id + citation.block,
                change: edit_block(citation.block, citation.rewritten),
                channel: typed_text
            )
        migration.status = applied
        migration.applied_by = participant
        migration.applied_at = now

    @invariant NothingIsRewrittenUnseen
        -- Una migración se mira antes de correr: qué títulos cambian, en qué
        -- bloques y cuántos. Renombrar una palabra en seiscientas páginas sin
        -- que nadie las haya visto es indistinguible de que alguien haya escrito
        -- algo que nunca escribió.

    @invariant AMigrationIsOrdinaryOperations
        -- Cada bloque que cambia lo hace por el mismo `edit_block` que enviaría
        -- una persona escribiendo. Queda en el registro, con su secuencia y su
        -- procedencia, y se puede leer, auditar y deshacer uno por uno. Una vía
        -- rápida que escribiera en la base sin pasar por ahí dejaría un corpus
        -- con cambios que su propia historia no explica.

    @invariant MigratingLeavesTheHandAlone
        -- Un bloque que una migración reescribe conserva su autor y su fecha.
        -- Migrar no es escribir, igual que archivar no es escribir: quien corrió
        -- la migración cambió a qué apunta una cita, no dijo lo que el bloque
        -- dice.
        --
        -- Es la misma regla que agent/MovingLeavesTheHandAlone y se declara por
        -- la misma razón: «aquí la mano no cambia» es exactamente la clase de
        -- cosa que se implementa mal por omisión. Sin ella, migrar una palabra
        -- refirmaría seiscientos bloques a nombre de quien pulsó el botón, y en
        -- un corpus de varias manos eso borra justo lo que no se puede perder.
        --
        -- Qué migración tocó un bloque queda dicho aparte, de modo que «quién lo
        -- escribió» y «quién lo migró» sean dos preguntas con dos respuestas.

    @invariant AMigrationIsIdempotent
        -- Correrla dos veces no hace nada la segunda. Se interrumpe a mitad sin
        -- dejar el corpus a medio migrar, y se reanuda sin repetir lo hecho.
}

rule CuratorConfirmsSemanticType {
    when: ConfirmTypeAssignment(participant, assignment)

    requires: assignment.status = suggested

    ensures:
        assignment.status = confirmed
        assignment.decided_by = participant
}

rule CuratorRejectsSemanticType {
    when: RejectTypeAssignment(participant, assignment)

    requires: assignment.status = suggested

    ensures:
        assignment.status = rejected
        assignment.decided_by = participant
}

rule HumanCorrectsSemanticTypeDecision {
    when: CorrectTypeAssignment(participant, assignment, status)

    requires: participant.kind = human
    requires: status = confirmed or status = rejected

    ensures:
        assignment.status = status
        assignment.decided_by = participant
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant AssignmentTargetsOneContentEntity {
    for assignment in TypeAssignments:
        (assignment.page != null or assignment.block != null) and
        not (assignment.page != null and assignment.block != null)
}

invariant MultipleTypesMayDescribeOnePage {
    for assignment in TypeAssignments:
        assignment.page != null implies assignment.semantic_type.ontology = assignment.ontology
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

actor OntologyParticipant {
    within: Ontology
    identified_by: core/Participant where core/Membership{participant: this, graph: within.graph}.status = active
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface OntologyCuration {
    facing participant: OntologyParticipant
    context ontology: Ontology

    exposes:
        ontology.types
        ontology.assignments

    provides:
        ProcessPage(participant, ontology, page)
        SuggestPageType(participant, ontology, semantic_type, page, rationale)
        SuggestBlockType(participant, ontology, semantic_type, block, rationale)
        AssertRelated(participant, ontology, definition, from, to)
        RelateConcept(participant, ontology, from, to, kind)
        MergeConcept(participant, ontology, absorbed, surviving)
        MigrateCitationsTo(participant, migration)
        ConfirmTypeAssignment(participant, assignment) when assignment.ontology = ontology
        RejectTypeAssignment(participant, assignment) when assignment.ontology = ontology
        CorrectTypeAssignment(participant, assignment, status) when assignment.ontology = ontology

    @guarantee SuggestionsAreNotSilentAssignments
        -- Automated classification creates a visible pending suggestion.
        -- It does not silently classify content as confirmed.

    @guarantee ComposableTypes
        -- A page or block may have multiple confirmed semantic types.

    @guarantee HumanFinalAuthority
        -- A human participant can correct a confirmed or rejected assignment.

    @guarantee ProcessingSaysWhatItDidAndWhatItCouldNot
        -- Processing reports which links it resolved, which it could not reach,
        -- and whether it had a model to read the page with. A silent partial
        -- result is read as a complete one, and a participant will believe a
        -- page was understood when half of it was skipped.

    @guarantee ALinkResolvedKeepsItsAddress
        -- Learning what a link points at never replaces the address written in
        -- the block. The title arrives beside it, as a suggestion to name it,
        -- and the source stays exactly what its author typed.

    @guarantee TypeAndTopicAreNeverTheSameQuestion
        -- What a page is and what it is about are asked separately and answered
        -- separately. A vocabulary that answers both at once with one word ends
        -- up answering neither: it is the failure mode of free tags, where
        -- `#pictograma` means «this is a pictogram» on one page and «this
        -- discusses pictograms» on the next, and no query can tell them apart.

    @guarantee AnInverseIsDerivedAndNeverStored
        -- A relation is written once, in its canonical direction, and asking it
        -- backwards is answered by an index. Two stored directions are two
        -- chances to disagree, and the corpus would have no way to say which of
        -- the two was right.

    @guarantee VocabularyChangesAreMigrationsAndNotRewrites
        -- Accepting a change of vocabulary produces an explicit migration:
        -- reviewable before it runs, idempotent, attributed, and reversible.
        -- Renaming a word across six hundred pages in silence is indistinguishable
        -- from someone having written something they never wrote.

    @guarantee FreeTagsSurviveTheirNormalisation
        -- The tags a corpus already carries are kept as written. What a concept
        -- proposes is an additional reading of them, never a replacement: they
        -- are the evidence of which concepts were needed, and the evidence does
        -- not get overwritten by the conclusion.

    @guarantee SmallStarterOntology
        -- A new ontology starts with only Persona, Organizacion, Lugar,
        -- Proyecto, Tarea, Idea, Evento, Fuente and Publicacion.
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "Which ontology changes may an agent curator apply without prior human confirmation?"
open question "When processing resolves a link, does the title it found belong in the block as text, in a property of the page, or in a record beside the link that the block never sees?"
open question "What does processing do with an address it cannot reach — say nothing, propose the link as dead, or leave a standing question to retry later, given that unreachable today and gone for ever look identical from here?"
open question "What happens when two composed semantic types define incompatible properties or lifecycles?"
open question "Are semantic types assigned to pages and blocks equally, or do some types permit only one target kind?"
open question "Does a Concept live as a page of the corpus — linkable, with its own backlinks and history — or as a record beside it, given that as a page it becomes something one can write about and that may be exactly the point?"
open question "Can a relation be asserted between two entities whose types the relation's domain and range do not admit — refused, allowed with a warning, or allowed because the ontology is likely to be the thing that is wrong?"
open question "Which relations are editable and which are necessarily derived from links, authorship, operations or external imports, given that a derived relation edited by hand would contradict the very thing it derives from?"
