-- allium: 3
-- federated-sharing.allium

-- Scope: Sharing selected pages from a sovereign personal Vera library
-- Includes: Delimited selections, individual and shared destinations,
--   synchronised replicas, local editing, origin review, provenance and
--   withdrawal limits
-- Excludes:
--   - Authentication and grant mechanics (identity-access.allium)
--   - Conflict resolution between divergent copies
--   - Transport and storage implementation
-- Dependencies: Graph, Page and Participant are governed by core.allium

use "./core.allium" as core

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

contract SovereignSharing {
    share: (selection: SharedSelection, destination: SharingDestination) -> Distribution
    edit: (distribution: Distribution, author: core/Participant, page: core/Page) -> SharedEdit
    review: (edit: SharedEdit, owner: core/Participant, decision: ReviewDecision) -> SharedEdit
    withdraw: (distribution: Distribution) -> Withdrawal

    @invariant SharingIsDelimited
        -- Sharing a project or concept selects pages explicitly or by a visible
        -- criterion. It never grants the destination discovery of the remaining
        -- personal library merely because selected pages came from it.

    @invariant TheOriginAndHistoryTravel
        -- Every delivered page keeps a stable reference to its source library,
        -- source page and shared history. A synchronised copy does not pretend
        -- to be an unrelated page merely because it now lives elsewhere.

    @invariant OriginMeansWhereSharingBegan
        -- Origin is literally the personal library and page from which the
        -- sovereign participant first shared the resource. Synchronising,
        -- editing, accepting changes or sharing onward never transfers or
        -- rewrites that origin.

    @invariant HorizontalParticipationDoesNotEraseOrigin
        -- Participants with equivalent writing authority collaborate
        -- horizontally inside the granted relationship. Equality of permission
        -- does not make every replica an origin or remove the source owner's
        -- responsibility for the canonical history.

    @invariant AReceivedCopyEntersAnotherSovereignty
        -- A person, shared graph or site that synchronises content receives a
        -- replica it can retain independently. While sharing remains active,
        -- replicas point to the same logical page identity rather than becoming
        -- unrelated documents. The source cannot silently erase a retained
        -- replica or truthfully promise that withdrawal will recover it.

    @invariant AuthorisedEditorsDoNotWaitToWork
        -- A participant to whom the selection was shared with write authority
        -- changes their replica without prior approval. Their hand does not wait
        -- for the origin to be online or for its owner to review the difference.

    @invariant TheOriginReviewsWhatReturns
        -- A remote edit does not silently enter the source library's canonical
        -- page. Synchronisation presents the differences to the sovereign owner,
        -- who accepts or rejects them before they join the source history.

    @invariant AcceptanceAndRejectionStayAttributed
        -- Accepting records the remote author and the owner who accepted; it
        -- never reattributes the contribution to the owner. Rejecting preserves
        -- enough evidence to explain why replicas differ without adding the
        -- proposed content to the canonical page.

    @invariant UnsharingEndsTheRelationship
        -- The owner can stop future synchronisation and editing authority by
        -- withdrawing the distribution. This ends the relationship; it does not
        -- erase replicas or observations recipients already retained.

    @invariant WithdrawalStopsTheFutureNotThePast
        -- Withdrawing stops future discovery and synchronisation from the
        -- source and may propagate a request for recipients to remove retained
        -- copies. It does not report those copies erased without acknowledgement
        -- from every recipient that held one.

    @invariant IrreversibilityIsKnownBeforeSharing
        -- Before the first distribution, Vera tells the sovereign participant
        -- that recipients may retain synchronised copies and that public access
        -- can be observed or copied beyond Vera's control.
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum DestinationKind { participant | participants | shared_graph | shared_site | public }
enum DistributionStatus { offered | synchronised | withdrawn }
enum SharedEditStatus { local | awaiting_review | accepted | rejected }
enum ReviewDecision { accept | reject }

------------------------------------------------------------
-- Entities and Values
------------------------------------------------------------

entity SharedSelection {
    source: core/Graph
    pages: List<core/Page>
    criterion: String?
    selected_by: core/Participant
}

entity SharingDestination {
    kind: DestinationKind
    address: String
}

entity Distribution {
    selection: SharedSelection
    destination: SharingDestination
    status: DistributionStatus
    shared_at: Timestamp
    withdrawal: Withdrawal?
    edits: SharedEdit with distribution = this
}

entity Withdrawal {
    distribution: Distribution
    requested_at: Timestamp
    acknowledged_by: List<String>
}

entity SharedEdit {
    distribution: Distribution
    page: core/Page
    author: core/Participant
    recorded_at: Timestamp
    status: SharedEditStatus
    reviewed_by: core/Participant?
    reviewed_at: Timestamp?
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant ASelectionNeverEscapesItsSourceGraph {
    for selection in SharedSelections:
        selection.pages.all(page => page in selection.source.pages)
}

invariant AWithdrawalNamesAWithdrawnDistribution {
    for withdrawal in Withdrawals:
        withdrawal.distribution.status = withdrawn
}

invariant ASharedEditBelongsToTheSharedSelection {
    for edit in SharedEdits:
        edit.page in edit.distribution.selection.pages
}

invariant AReviewedEditNamesItsReviewer {
    for edit in SharedEdits:
        (edit.status = accepted or edit.status = rejected) implies edit.reviewed_by != null
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

-- Answered: an authorised participant edits their replica directly; the source
-- owner accepts or rejects the differences when they return.
open question "When a shared selection criterion gains or loses a page, does synchronisation follow the criterion automatically or require a new sharing decision?"
open question "What acknowledgement proves that a recipient honoured a withdrawal request, and how long is that evidence retained?"
open question "Can a public destination synchronise canonical page identity, or does it receive only a publication projection?"
open question "When the origin withdraws while recipients have accepted or pending edits, do their replicas freeze as archival forks, may a recipient adopt a continuing fork with a new canonical custodian, or must custodianship be transferred before withdrawal?"
