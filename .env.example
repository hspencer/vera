# Configuración de una instancia de Vera.
#
# Copia este archivo a `.env` y llénalo. `.env` no se versiona nunca: lleva los
# secretos de una instancia concreta. Este sí, y por eso dice qué hay que llenar
# sin decir con qué.
#
# Nada de esto es obligatorio. Vera corre sin `.env` con los valores de abajo,
# que son los que sirven en la máquina de quien la escribe. Lo que se pone aquí
# se pisa con un argumento en la línea de comandos, porque quien escribe un
# argumento lo escribió para esa corrida.


# --- Dónde escucha ----------------------------------------------------------

VERA_PORT=4173

# Loopback. Cambiar esto es una decisión consciente y hoy tiene un costo: las
# personas todavía no se autentican ante Vera (identity-access.allium lo declara
# como pregunta abierta), así que fuera de loopback cualquiera que alcance el
# puerto escribe como el dueño. La forma segura de exponer Vera hoy es dejarla en
# 127.0.0.1 y poner delante algo que termine TLS y controle quién llega —
# `tailscale serve` en esta instalación.
VERA_HOST=127.0.0.1


# --- Dónde vive el corpus ---------------------------------------------------

# La base canónica. Es un archivo SQLite y no tiene usuario ni contraseña: quien
# puede leer el archivo puede leer el grafo, y quien puede escribirlo puede
# escribirlo. Su control de acceso son los permisos del sistema de archivos, y la
# raíz de confianza de una instancia soberana es tener el disco. No busques una
# VERA_DATABASE_PASSWORD: no existe, y que no exista es la decisión.
VERA_DATABASE=data/vera.sqlite

# El almacén direccionado por contenido: audio, imágenes, todo binario.
VERA_OBJECTS=objects

# La PWA construida, que el servidor sirve como estáticos.
VERA_WEB_ROOT=packages/web/dist


# --- Voz --------------------------------------------------------------------
#
# La transcripción corre en esta máquina y el audio no sale de ella. Vera busca
# los binarios en el PATH y además en `~/.local/bin`, `~/bin`, `/usr/local/bin` y
# los de Homebrew, así que normalmente no hay que decir nada aquí. Se apunta a
# mano cuando están en otra parte o cuando hay más de una versión instalada.

# VERA_FFMPEG=/usr/local/bin/ffmpeg
# VERA_WHISPER=/usr/local/bin/whisper-cli
# VERA_WHISPER_MODEL=/home/tu-usuario/.local/share/whisper/ggml-base.bin
VERA_WHISPER_LANGUAGE=es


# --- Credenciales de agentes ------------------------------------------------
#
# El secreto de una credencial se muestra UNA sola vez, al emitirla: Vera guarda
# lo que prueba el secreto y nunca el secreto (agent-participation.allium,
# @invariant TheSecretIsNeverStored). Si se pierde, no se recupera de nada que
# Vera tenga — se emite otra y se revoca la anterior.
#
# Guardar aquí el secreto de un agente no contradice ese invariante: quien lo
# guarda es el portador de la credencial, no Vera.
#
# Para emitir una:
#
#   curl -s -X POST http://127.0.0.1:4173/agents/credentials \
#     -H 'content-type: application/json' \
#     -d '{"participant":"participant:cotito","scopes":["read","write"],"label":"cotito"}'
#
# Alcances posibles: read, write, discard. Se dan los que el agente necesita y no
# más: el alcance se comprueba contra cada cambio, no una vez en la puerta.
#
# Y para usarla:
#
#   curl -H "authorization: Bearer $VERA_COTITO_TOKEN" ...

VERA_COTITO_TOKEN=
