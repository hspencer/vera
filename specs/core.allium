-- allium: 3
-- core.allium

-- Scope: Participation, provenance, semantic graph changes and personal publishing
-- Includes: Human and agent participants, authenticated submissions, revisions,
--   canonical human voice evidence, public/private page visibility, and projection
--   of public graph pages as a personal website
-- Excludes:
--   - Storage engine, file layout and database schema
--   - Network protocol and client implementation
--   - Graph visual layout (specified separately, informed by logseq-constel)
--   - Authentication mechanism
--   - Git commit and deployment mechanics

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value OriginEvidence {
    reference: String
    captured_at: Timestamp
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum ParticipantKind { human | agent }
enum ParticipantStatus { active | suspended }
enum ContributionChannel { typed_text | authenticated_voice | agent_generation | import }
enum Visibility { private | public }
enum ChangeKind { create_page | rename_page | create_block | edit_block | move_block | remove_block | set_property | link_pages }
enum SubmissionStatus { submitted | accepted | rejected }

------------------------------------------------------------
-- Entities
------------------------------------------------------------

entity Participant {
    name: String
    kind: ParticipantKind
    status: ParticipantStatus
    memberships: Membership with participant = this
}

entity Graph {
    name: String
    memberships: Membership with graph = this
    pages: Page with graph = this
}

entity Membership {
    graph: Graph
    participant: Participant
    status: ParticipantStatus
}

entity Page {
    graph: Graph
    title: String
    visibility: Visibility
    blocks: Block with page = this
    revisions: Revision with page = this
}

entity PersonalSite {
    graph: Graph
    owner: Participant
    title: String
    canonical_domain: String
    publications: Publication with site = this
}

entity Block {
    stable_id: String
    page: Page
    content: String
    revisions: Revision with block = this
}

entity Change {
    kind: ChangeKind
    page: Page?
    block: Block?
    content: String?
}

entity Submission {
    graph: Graph
    submitted_by: Participant
    change: Change
    channel: ContributionChannel
    evidence: OriginEvidence?
    submitted_at: Timestamp
    status: SubmissionStatus
    rejection_reason: String?
}

entity Revision {
    graph: Graph
    page: Page?
    block: Block?
    change: Change
    authored_by: Participant
    channel: ContributionChannel
    evidence: OriginEvidence?
    recorded_at: Timestamp

    origin_is_canonical: channel = authenticated_voice and evidence != null
}

entity Publication {
    site: PersonalSite
    page: Page
    revision: Revision
    path: String
    published_at: Timestamp
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule AcceptParticipantSubmission {
    when: ParticipantSubmits(participant, graph, change, channel, evidence?)

    let membership = Membership{graph, participant}

    requires: exists membership
    requires: membership.status = active
    requires: channel != authenticated_voice or evidence != null

    ensures:
        let submission = Submission.created(
            graph: graph,
            submitted_by: participant,
            change: change,
            channel: channel,
            evidence: evidence,
            submitted_at: now,
            status: accepted,
            rejection_reason: null
        )
        Revision.created(
            graph: graph,
            page: change.page,
            block: change.block,
            change: change,
            authored_by: participant,
            channel: channel,
            evidence: evidence,
            recorded_at: now
        )
        SubmissionAccepted(submission: submission)
}

rule PublishVisiblePageRevision {
    when: PublishPage(participant, site, page, revision, path)

    let membership = Membership{graph: page.graph, participant: participant}

    requires: exists membership
    requires: membership.status = active
    requires: participant.kind = human
    requires: site.owner = participant
    requires: site.graph = page.graph
    requires: page.visibility = public
    requires: revision.page = page

    ensures: Publication.created(
        site: site,
        page: page,
        revision: revision,
        path: path,
        published_at: now
    )
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant VoiceCanonicalityRequiresEvidence {
    for revision in Revisions:
        revision.origin_is_canonical implies revision.evidence != null
}

invariant PrivatePagesAreNeverPublished {
    for publication in Publications:
        publication.page.visibility = public
}

invariant OnlySiteOwnerPublishes {
    for publication in Publications:
        publication.site.owner.kind = human
}

invariant PublicationBelongsToSiteGraph {
    for publication in Publications:
        publication.page.graph = publication.site.graph
}

invariant RevisionParticipantBelongsToGraph {
    for revision in Revisions:
        exists Membership{graph: revision.graph, participant: revision.authored_by}
}

invariant BlockStableIdentityIsUnique {
    for a in Blocks:
        for b in Blocks:
            a != b implies a.stable_id != b.stable_id
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

actor VeraParticipant {
    within: Graph
    identified_by: Participant where Membership{participant: this, graph: within}.status = active
}

actor PersonalSiteOwner {
    within: PersonalSite
    identified_by: Participant where this = within.owner
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface GraphParticipation {
    facing participant: VeraParticipant
    context graph: Graph

    exposes:
        graph.name
        graph.pages

    provides:
        ParticipantSubmits(participant, graph, change, channel, evidence?)

    @guarantee EqualMutationPath
        -- Human and agent participants submit changes through this same boundary.
        -- Participant kind does not grant a privileged write path.

    @guarantee AttributedHistory
        -- Every accepted change produces a revision attributed to its participant
        -- and contribution channel.
}

surface PersonalSitePublication {
    facing owner: PersonalSiteOwner
    context site: PersonalSite

    exposes:
        site.title
        site.canonical_domain
        site.publications

    provides:
        PublishPage(owner, site, page, revision, path) when page.visibility = public

    @guarantee HumanPublicationAuthority
        -- Only the human owner of the personal site authorizes publication.
        -- Agents may prepare public-ready pages but cannot publish them.

    @guarantee StablePublicAddress
        -- A publication has an explicit path under the site's canonical domain,
        -- independent of the technology used to render or deploy the site.
}

------------------------------------------------------------
-- Deferred Specifications
------------------------------------------------------------

deferred ChangeApplication.apply       -- see: change-application.allium
deferred GraphNavigation.present       -- see: graph-navigation.allium
deferred OfflineSubmission.reconcile   -- see: offline-reconciliation.allium
deferred PersonalSiteProjection.render -- see: personal-site-projection.allium
deferred ContentMedia.present           -- see: content-media.allium
deferred WorkspaceInterface.present     -- see: workspace-interface.allium
deferred ControlledOntology.curate      -- see: controlled-ontology.allium
deferred BibliographicIntegration.sync  -- see: bibliographic-integration.allium
deferred IdentityAccess.authorize        -- see: identity-access.allium

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "What is the smallest semantic change vocabulary needed for the first usable Vera?"
open question "Can a participant revise another participant's contribution without preserving both voices visibly?"
open question "When the exceptional case occurs and two devices changed the same block offline, which changes may Vera merge automatically and which require explicit human resolution?"
open question "Are pages and blocks sufficient as Vera's canonical content model, or are typed nodes needed?"
open question "Which historical metadata and asset behaviours from herbertspencer.net must Vera preserve exactly?"
