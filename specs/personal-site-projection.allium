-- allium: 3
-- personal-site-projection.allium

-- Scope: Projection of deliberate publication sites from a personal Vera graph,
--   including Vera's official project site and the eventual migration of doble pagina
-- Includes: Public page rendering, canonical URLs, HTML metadata, public search,
--   citations, Markdown footnotes, and ingestion of historical Jekyll content
-- Excludes:
--   - Static site generator and deployment implementation
--   - Jekyll compatibility as a permanent runtime requirement
--   - Detailed visual design and CSS implementation
-- Current first site: vera.mediafranca.net is the official site of the Vera
--   project, not a projection of Herbert's public identity or other projects

use "./core.allium" as core
use "./special-pages.allium" as special

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

contract PersonalWebsiteProjection {
    render: (publication: core/Publication) -> PublicDocument
    metadata: (publication: core/Publication) -> HtmlMetadata
    search: (site: core/PersonalSite, text: String) -> PublicSearchResult
    citation: (publication: core/Publication, style: String) -> PublicationCitation

    @invariant SameCorpus
        -- Every public document is projected from a page in Vera's graph.
        -- The website does not maintain an independent canonical copy of content.

    @invariant CanonicalAddress
        -- Every public document has one stable canonical URL.

    @invariant PublicDiscoverability
        -- Published pages expose useful HTML metadata, participate in public
        -- search and provide a stable, shareable citation.

    @invariant RecognisableSiteIdentity
        -- Browser tabs, installed shortcuts and social previews use the site's
        -- declared mark in formats appropriate to each surface.

    @invariant FootnoteFidelity
        -- Markdown footnote references and definitions remain correctly linked
        -- and readable when projected to public HTML.

    @invariant HumanSelectableCitationStyle
        -- A reader chooses the desired citation style, such as APA or Chicago,
        -- and receives a human-readable citation ready to copy.

    @invariant ReproducibleOutput
        -- The same publication revision and presentation configuration produce
        -- equivalent public output independent of deployment technology.

    @invariant SiteMembershipIsExplicit
        -- Public visibility makes a page eligible for publication; it does not
        -- put that page into every site. A build receives only publications
        -- explicitly assigned to that site. Vera's project site therefore does
        -- not inherit Herbert's other public pages, projects or personal work.

    @invariant PublicationOpensTheFutureNotThePrivatePast
        -- Publishing reveals the page state at that instant and its later
        -- revisions. It never reveals revisions recorded before published_at.

    @invariant PrivateLinksRevealNoPrivateNode
        -- Words that name a private page remain readable as authored text, but
        -- the public projection neither confirms a node exists nor exposes a
        -- route, backlink, search result or graph edge for it.
}

------------------------------------------------------------
-- Entities
------------------------------------------------------------

entity PublicDocument {
    publication: core/Publication
    canonical_url: String
    html: String
}

entity HtmlMetadata {
    publication: core/Publication
    title: String
    description: String
    canonical_url: String
    language: String
    image_url: String?
    search_indexable: Boolean
}

entity PublicSearchResult {
    site: core/PersonalSite
    text: String
    matching_publications: Set<core/Publication>
}

entity PublicationCitation {
    publication: core/Publication
    style: String
    human_readable: String
    stable_url: String
}

entity LegacyContent {
    site: core/PersonalSite
    source_path: String
    public_url: String
    markdown_source: String
    metadata_source: String
}

entity LegacyMigration {
    legacy_content: LegacyContent
    page: core/Page
    imported_by: core/Participant
    imported_at: Timestamp
    preserved_public_url: String
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule RenderPublishedPage {
    when: RenderPublication(publication)

    requires: publication.page.visibility = public

    ensures: PublicDocument.created(
        publication: publication,
        canonical_url: canonical_url(publication.site, publication.path),
        html: render_publication(publication)
    )
}

rule GeneratePublishedPageMetadata {
    when: GenerateHtmlMetadata(publication)

    requires: publication.page.visibility = public

    ensures: HtmlMetadata.created(
        publication: publication,
        title: publication.page.title,
        description: publication_description(publication),
        canonical_url: canonical_url(publication.site, publication.path),
        language: publication_language(publication),
        image_url: publication_image(publication),
        search_indexable: true
    )
}

rule SearchPublicSite {
    when: SearchPublishedPages(site, text)

    ensures: PublicSearchResult.created(
        site: site,
        text: text,
        matching_publications: search_publications(site, text)
    )
}

rule GeneratePublicationCitation {
    when: CitePublication(publication, style)

    requires: publication.page.visibility = public

    ensures: PublicationCitation.created(
        publication: publication,
        style: style,
        human_readable: human_citation(publication, style),
        stable_url: canonical_url(publication.site, publication.path)
    )
}

rule ImportHistoricalContentIntoGraph {
    when: ImportLegacyContent(participant, legacy_content, page)

    let site = legacy_content.site
    let membership = core/Membership{graph: site.graph, participant: participant}

    requires: exists membership
    requires: membership.status = active
    requires: site.owner = participant
    requires: page.graph = site.graph

    ensures: LegacyMigration.created(
        legacy_content: legacy_content,
        page: page,
        imported_by: participant,
        imported_at: now,
        preserved_public_url: legacy_content.public_url
    )
}

-- `Vera:Publicación` es la superficie canónica de estas decisiones, no una
-- segunda copia de ellas. Aplicar lo que el dueño decidió allí cambia el
-- PersonalSite existente; el sitio, sus publicaciones y sus revisiones siguen
-- siendo las entidades gobernadas por core.allium.
rule ConfigurePersonalSiteFromPublicationPage {
    when: ConfigurePersonalSite(owner, publication_page, site, title, canonical_domain, entry_point)

    requires: owner = site.owner
    requires: owner.kind = human
    requires: publication_page.kind = publication
    requires: publication_page.graph = site.graph
    requires: publication_page.page.title = "Vera:Publicación"
    requires: non_blank(title)
    requires: is_absolute_https_origin(canonical_domain)
    requires: entry_point.graph = site.graph
    requires: entry_point.visibility = public
    requires: exists core/Publication{site: site, page: entry_point}

    ensures:
        site.title = title
        site.canonical_domain = canonical_domain
        site.entry_point = entry_point

    @guidance
        -- canonical_domain names an origin only: scheme and host, with no path,
        -- query or fragment. A preview may be served elsewhere without changing
        -- the canonical public address written here.
}

-- La tabla de páginas de `Vera:Publicación` no inventa otra colección. Publicar
-- desde ella encadena el mismo acto humano de core y crea la misma Publication
-- con su frontera histórica, ruta y autor.
rule PublishPageFromPublicationPage {
    when: PublishFromPublicationPage(owner, publication_page, site, page, path)

    requires: owner = site.owner
    requires: owner.kind = human
    requires: publication_page.kind = publication
    requires: publication_page.graph = site.graph
    requires: publication_page.page.title = "Vera:Publicación"
    requires: page.graph = site.graph
    requires: page.visibility = public
    requires: valid_publication_path(path)
    requires: not exists core/Publication{site: site, page: page}

    ensures: core/PublishPage(owner, site, page, path)
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant PublicDocumentsComeFromPublicPages {
    for document in PublicDocuments:
        document.publication.page.visibility = public
}

invariant MetadataUsesCanonicalDocumentUrl {
    for metadata in HtmlMetadatas:
        metadata.canonical_url = canonical_url(metadata.publication.site, metadata.publication.path)
}

invariant HistoricalUrlsArePreserved {
    for migration in LegacyMigrations:
        migration.preserved_public_url = migration.legacy_content.public_url
}

invariant SearchReturnsOnlyPublicPages {
    for result in PublicSearchResults:
        result.matching_publications.all(p => p.page.visibility = public)
}

invariant CitationsUseCanonicalDocumentUrl {
    for citation in PublicationCitations:
        citation.stable_url = canonical_url(citation.publication.site, citation.publication.path)
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

actor SiteOwner {
    within: core/PersonalSite
    identified_by: core/Participant where this = within.owner
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface PersonalWebsite {
    context site: core/PersonalSite

    exposes:
        site.title
        site.canonical_domain
        site.entry_point
        site.publications

    provides:
        SearchPublishedPages(site, text)
        CitePublication(publication, style)

    contracts:
        fulfils PersonalWebsiteProjection

    @guarantee PublicOnly
        -- The website reveals only explicitly published pages and their
        -- deliberately public media and metadata.

    @guarantee EntryPointOccupiesTheSiteRoot
        -- The configured published page is the document at the site root. It is
        -- not a separate copied homepage or an automatically chosen index.

    @guarantee BrandSurvivesEveryPublicSurface
        -- The same recognisable mark appears as favicon, touch icon, installable
        -- application icon and public preview without depending on private assets.
}

surface StaticSiteBuild {
    facing owner: SiteOwner
    context site: core/PersonalSite

    exposes:
        site.publications

    provides:
        RenderPublication(publication) when publication.site = site and site.owner = owner
        GenerateHtmlMetadata(publication) when publication.site = site and site.owner = owner

    @guarantee BuildHasNoPrivateInput
        -- Building the public site receives only the site's explicit
        -- publications. It cannot enumerate the graph and then remember to
        -- filter private pages afterwards.

    @guarantee BuildHasNoUnassignedPublicInput
        -- A public page assigned to another site is as absent from this build as
        -- a private page. Visibility and membership in a publication are
        -- independent decisions.
}

surface HistoricalSiteMigration {
    facing owner: SiteOwner
    context site: core/PersonalSite

    exposes:
        site.title
        site.canonical_domain

    provides:
        ImportLegacyContent(owner, legacy_content, page)

    @guarantee LosslessEditorialMigration
        -- Import preserves Markdown source, relevant metadata and the original
        -- public URL while making the resulting page part of Vera's graph.
}

-- La página especial no es un panel que guarda su propia configuración. Es la
-- vista legible y editable de las entidades de publicación ya gobernadas por
-- core: el sitio, su portada y la colección explícita de Publication.
surface VeraPublicationPage {
    facing owner: SiteOwner
    context site: core/PersonalSite
        where exists special/SpecialPage{graph: site.graph, kind: publication}
    let publication_page = special/SpecialPage{graph: site.graph, kind: publication}

    exposes:
        publication_page.page
        site.title
        site.canonical_domain
        site.entry_point
        for publication in site.publications:
            publication.page
            publication.path
            publication.first_revision
            publication.published_at
            publication.published_by

    provides:
        ConfigurePersonalSite(owner, publication_page, site, title, canonical_domain, entry_point)
        PublishFromPublicationPage(owner, publication_page, site, page, path)

    contracts:
        fulfils special/SelfDescription

    @guarantee CanonicalSpecialPage
        -- The owner's publication configuration is reached at exactly
        -- `Vera:Publicación`, declared with special kind `publication`. The kind,
        -- not a private title check, is what gives the page authority.

    @guarantee ExistingDomainIsTheOnlyConfigurationState
        -- The page edits the existing PersonalSite and Publication entities. It
        -- does not maintain a second settings record, publication list or copied
        -- homepage that could drift from the graph.

    @guarantee SettingsUseStableHumanNames
        -- The page names its three required settings `title`, `url` and
        -- `entryPoint`. `url` is the human-facing name of canonical_domain; it
        -- accepts one absolute HTTPS origin, while `entryPoint` selects a Page
        -- rather than storing a title or URL that could later resolve elsewhere.

    @guarantee InvalidSettingsRemainVisibleAndInactive
        -- An empty title, a URL that is not an absolute HTTPS origin, a private
        -- or foreign entry point, or a page not already published in this site
        -- does not become effective. The rejected value and its reason remain
        -- visible on `Vera:Publicación`; the last valid configuration continues.

    @guarantee PublicationMembershipAndPathsAreExplicit
        -- Public visibility makes a page eligible but never publishes it. Each
        -- row names one Publication, its unique site-relative path, the revision
        -- from which its public history begins, and the human act that opened it.

    @guarantee EntryPointIsTheRootDocument
        -- The chosen entry point is an already published page of this same site
        -- and graph. Its document occupies the canonical origin root without a
        -- copied homepage or an automatically selected fallback.

    @guarantee PreviewDoesNotRewriteCanonicalIdentity
        -- Serving the projection at an internal preview address changes neither
        -- canonical_domain nor the canonical URLs and citations emitted by the
        -- public projection.

------------------------------------------------------------
-- Deferred Specifications
------------------------------------------------------------

deferred PublicPresentation.render -- see: public-presentation.allium
deferred SearchIndex.publish       -- see: public-search-index.allium
deferred JekyllMigration.ingest    -- see: jekyll-migration.allium

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "Which current HTML metadata fields and structured data must be preserved exactly?"
open question "Should the first migration preserve the existing visual design exactly or reproduce its editorial character with Vera's token system?"
