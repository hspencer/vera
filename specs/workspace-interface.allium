-- allium: 3
-- workspace-interface.allium

-- Scope: Vera's navigable reading, editing and graph workspace
-- Includes: Installable progressive web application, responsive navigation,
--   native Markdown editing, text/graph/split layouts, 2D/3D graph modes,
--   breadcrumbs, search, internal queries, editable style sources and tokens,
--   light/dark themes
-- Excludes:
--   - CSS framework and component implementation
--   - D3 force simulation parameters
--   - Search index implementation and query execution engine
--   - Device-specific visual styling beyond observable responsive behaviour
-- References: Logseq and logseq-constel are implementation and interaction references

use "./core.allium" as core
use "./controlled-ontology.allium" as ontology

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

contract GraphQuerySupport {
    search: (graph: core/Graph, text: String) -> SearchResult
    query: (graph: core/Graph, expression: String) -> QueryResult

    @invariant CurrentGraphOnly
        -- Search and query results contain only information the participant
        -- is authorized to read from the current graph.

    @invariant VeraNativeQuerySemantics
        -- Vera's query language is chosen for clarity and current graph needs.
        -- It is not constrained to preserve Logseq query syntax.

    @invariant LogseqQueriesAreRebuilt
        -- Migration does not translate or import existing Logseq queries.
        -- Required queries are authored again using Vera's native semantics.
}

contract EditablePresentation {
    apply_theme: (theme: Theme) -> ThemeApplication

    @invariant TransparentStyleSource
        -- Theme tokens and stylesheet source remain directly inspectable and editable.

    @invariant DualColourScheme
        -- Every theme provides both light and dark colour schemes.
}

contract NativeMarkdownEditing {
    edit: (page: core/Page, source: String) -> core/Page

    @invariant ExternalLinksExposeTheirDestination
        -- Following an external link first presents its destination and offers
        -- copying the URL as well as opening it. On a device with Vera's native
        -- bridge, opening delegates to the operating system's default browser;
        -- cancelling leaves the current page and its editing state untouched.

    @invariant SourceRemainsMarkdown
        -- Editing produces portable Markdown rather than an opaque editor format.

    @invariant FootnotesRemainEditable
        -- Footnote references and definitions can be authored and revised as
        -- part of the page's Markdown source.

    @invariant FootnotesAreARoundTrip
        -- Following a footnote reference reaches its definition, whose return
        -- mark leads back to the precise reference occurrence from which the
        -- reader arrived, including when one note is cited more than once.

    -- Un índice al principio de una página larga es Markdown corriente, y hasta
    -- ahora no llevaba a ninguna parte: el enlace se dibujaba, se pulsaba y no
    -- pasaba nada. Los encabezados de Vera son bloques, no elementos con nombre,
    -- así que el destino de un ancla hay que ponerlo; y donde el destino no
    -- exista, el enlace no debe fingir que existe.
    @invariant AnchorsReachTheirHeading
        -- A link to an anchor within the page reaches the heading whose text
        -- produces that anchor, including when two headings produce the same one.
        -- An anchor that no heading produces is not presented as a link.

    @invariant RenderedPresentationIsFaithful
        -- Content not currently being edited is presented as rendered Markdown:
        -- headings, lists, quotations, code, tables, images, horizontal rules and
        -- footnote references read as themselves rather than as their marks.

    @invariant CodeBlocksWrapWithoutHorizontalScrolling
        -- Block code preserves authored whitespace and line breaks, but a line
        -- wider than the reading column wraps inside its code block. Reading code
        -- never requires a separate horizontal scrollbar, including when one
        -- uninterrupted token is wider than the available space.

    @invariant OrderedListsKeepTheirSequence
        -- Numbered items separated by blank source lines remain one ordered
        -- list rather than restarting at one. When the first authored ordinal
        -- is not one, the rendered list begins from that ordinal.

    @invariant EditingRevealsTheSource
        -- Beginning to edit replaces the rendered presentation with the exact
        -- Markdown source that produced it. Rendering is a view onto the source
        -- and never becomes the stored content, so no edit round-trips through
        -- the renderer and no rendering step can rewrite what was written.

    @invariant EmbeddedMarkupIsInert
        -- Markup written inside ordinary Markdown content is presented as text,
        -- not as active markup. Only a whole block deliberately created as
        -- executable HTML may cross that boundary, under
        -- executable-content-sandbox.allium. Media that Vera presents natively
        -- is governed by content-media.allium and never reaches the page by way
        -- of the Markdown renderer.

    @invariant FormattingIsOneEditingTool
        -- While a Markdown block is being edited, `/formato` reveals one bar
        -- above its source for bold, italic, strikethrough, links, quotation,
        -- code and H1–H3 headings. Those choices do not compete as separate
        -- first-level block commands; closing the bar leaves the same source and
        -- caret in place.

    @invariant FormattingWritesPortableMarkdown
        -- Inline formatting wraps or rewrites the selected source, while choosing
        -- H1, H2 or H3 transforms the whole block. The resulting Markdown source
        -- is what Vera preserves; the toolbar never stores an opaque rich-text form.

    @invariant FormattingNeverRetypesContentByAccident
        -- Formatting a Markdown block cannot turn it into HTML, p5.js, a query,
        -- Mermaid, drawing or media. Executable and specialised behaviours begin
        -- only through their explicit block command or recognised attachment.

    @invariant FormattingFloatsWithoutMovingTheText
        -- The formatting bar floats above the block being edited and occupies no
        -- space in the document flow: opening or closing it moves neither that
        -- block's source nor any block below it. It stays horizontally aligned
        -- with the editor. While a block taller than the viewport is edited, the
        -- bar remains at the top of the visible text pane instead of scrolling
        -- outside the screen.
}

-- A block has one primary way of being read, but no stored type field is needed.
-- Vera derives that behaviour from the source deliberately written in the block
-- or from the native media attached to it. The source remains the authority.
contract BlockBehaviourPresentation {
    behaviour_of: (block: core/Block) -> BlockBehaviour

    @invariant TheCurrentBlockBehavioursAreNamed
        -- Vera distinguishes standard Markdown, explicit executable HTML, audio,
        -- video, hand drawing, p5.js, query, Mermaid and Markdown table blocks.
        -- Each is presented and edited according to its own behaviour.

    @invariant BehaviourIsDerivedRatherThanDuplicated
        -- Markdown tables, queries, Mermaid, drawings, HTML and p5.js are
        -- recognised from their complete preserved source; audio and video are
        -- recognised from their native attachment. Vera does not keep a second
        -- mutable type label that can disagree with the content.

    @invariant MarkdownIsTheSafeDefault
        -- A block that does not unambiguously satisfy one specialised form is
        -- standard Markdown. Malformed or merely suggestive source is shown for
        -- editing and never executed, queried or silently repaired.

    @invariant ATableRemainsMarkdown
        -- A table receives table-aware presentation and editing because its
        -- complete source is a Markdown table. It remains portable Markdown and
        -- changing it back to ordinary prose needs no conversion or lost data.

    @invariant SpecialisedBlocksKeepTheirOwnEditor
        -- Editing opens the source, canvas or media controls appropriate to the
        -- derived behaviour. It never sends drawing coordinates, executable
        -- source or a query through the ordinary prose formatter.
}

contract BlockManipulation {
    copy_reference: (block: core/Block) -> BlockReference
    copy_block: (block: core/Block) -> String
    move_to_page: (block: core/Block, page: core/Page) -> core/Block
    discard_empty: (participant: core/Participant, block: core/Block) -> core/Page
    discard_subtree: (participant: core/Participant, block: core/Block, confirmed_descendant_count: Integer) -> core/Page
    select_range: (from: core/Block, to: core/Block) -> BlockSelection
    discard_selection: (participant: core/Participant, selection: BlockSelection) -> core/Page
    shift_selection: (participant: core/Participant, selection: BlockSelection, deeper: Bool) -> core/Page

    @invariant ReferenceNamesStableIdentity
        -- A copied reference names the block's stable_id, so it keeps pointing at
        -- the same block after that block is edited, moved to another parent, or
        -- its page is renamed.

    @invariant ReferenceResolvesToItsBlock
        -- A reference presented in the workspace can be followed to the block it
        -- names. A reference that cannot be followed is not a reference.

    @invariant ImpossibleActionsDoNotLengthenTheMenu
        -- The block menu contains only actions that can act on the selected
        -- block in its present context. An unavailable action is absent rather
        -- than occupying a disabled row in every block.

    @invariant VariantsFollowTheirSharedVerb
        -- Copying is one first-level action and moving is another. Choosing one
        -- reveals its applicable variants; reference, identity and Markdown do
        -- not compete as three unrelated verbs in the main block menu.

    @invariant MovingToAnotherPageAppendsTheSubtree
        -- Moving a block to a searched destination keeps its stable identity
        -- and descendants, makes it a root block there, and places it after the
        -- destination page's existing root blocks.

    @invariant OnlyEmptyBlocksAreDiscarded
        -- Discarding by emptying removes a block only when its content is empty.
        -- Text is never lost to a keystroke that was meant to delete a character.

    @invariant DiscardingIsAnOrdinaryChange
        -- Removing a block from the workspace submits the same remove_block
        -- operation as any other participant would, with the same provenance and
        -- the same ordering. The interface has no shorter path to the graph.

    @invariant DiscardingAParentNamesEverythingThatWillGo
        -- Before a participant can discard a block with descendants, Vera warns
        -- "vas a borrar este bloque con n hijos", where n is the exact number of
        -- descendants at every depth that will also be removed. Confirmation is
        -- valid only for that block and that count; if the subtree changes, Vera
        -- presents its new count and asks again.

    @invariant DiscardingAParentRemovesTheWholeSubtree
        -- A confirmed parent discard removes every descendant and then the chosen
        -- block, deepest leaves first. Each removal remains an ordinary auditable
        -- remove_block operation, and no surviving block is left without its parent.

    @invariant ASelectionIsWhatIsOnScreenBetweenTwoBlocks
        -- A range runs over the blocks as they are read, in the order they are
        -- drawn, and not over the tree as it is stored. What is folded away is
        -- not in the range: it is not on screen, so nobody chose it. Selecting
        -- over the stored order would take in blocks the participant cannot see
        -- and would make a deletion mean something other than what it looked
        -- like.

    @invariant SelectingAParentSelectsWhatHangsFromIt
        -- A block chosen with its subtree folded shut carries that subtree. The
        -- fold is a way of reading, not a way of storing: a participant who
        -- folds a section and then discards it means the section, not its first
        -- line. What is carried is stated before anything is removed.

    @invariant DiscardingASelectionIsDeliberate
        -- Removing several blocks at once is refused unless the participant said
        -- so about that particular set, with the count of what goes in front of
        -- them, whenever any of it holds text. This is the same rule as
        -- OnlyEmptyBlocksAreDiscarded seen from the other side: that one keeps a
        -- keystroke from destroying a character's worth of writing by accident,
        -- and this one keeps a keystroke from destroying a chapter's worth. The
        -- record makes every removal auditable afterwards; nothing in Vera makes
        -- one recoverable.

    @invariant ASelectionIsRemovedLeavesFirst
        -- Discarding a selection submits one remove_block per block, deepest
        -- first, because the graph refuses to remove a block that still has
        -- children. The sequence is ordinary and auditable operation by
        -- operation, exactly as ApplyRemovePage requires of emptying a page.

    @invariant OnlyTheRootsOfASelectionMove
        -- Shifting a selection moves only those blocks in it that do not hang
        -- from another block in it. A subtree travels with the block it hangs
        -- from, so moving a parent and then its child would move the child
        -- twice and land it somewhere nobody asked for.

    @invariant ShiftingASelectionMeansWhatItMeansForOne
        -- Indenting makes each block a child of the sibling above it, at the end
        -- of that sibling's children; outdenting makes it a sibling of its own
        -- parent, immediately after it. These are the same two rules that govern
        -- a single block. A range does not get its own idea of what Tab means,
        -- because someone who learned it on one block already knows it.

    @invariant AShiftedSelectionKeepsItsOrder
        -- Blocks that were read in an order are read in that order afterwards.
        -- What a range adds over a single block is only the sequence in which
        -- the moves are submitted; the destination of each is decided before any
        -- of them moves.

    @invariant AShiftedSelectionStaysSelected
        -- Shifting leaves the same blocks chosen, so the gesture can be repeated
        -- without pointing at them again. Indenting three levels is three
        -- presses, not three selections.

    @invariant NothingIsSelectedWhileWriting
        -- A selection and a caret are two different answers to "what does the
        -- next keystroke act on", and only one of them can be right. Beginning
        -- to write clears the selection; making a selection leaves the writing.
}

-- La cabecera de una página: lo que se pregunta de ella antes de leerla.
--
-- Cuatro naturalezas distintas conviven ahí y la interfaz tiene que ser honesta
-- sobre cuál es cuál, porque lo que se puede hacer con cada una es distinto:
-- estado gobernado con sus propias reglas (la visibilidad), tipos y conceptos
-- declarados sobre el vocabulario, propiedades libres que el corpus trae
-- escritas, y hechos derivados del registro. Dibujarlas iguales es afirmar que
-- se comportan igual.
contract PageFrontMatter {
    offer: (page: core/Page, key: String) -> PropertyControl
    answer: (page: core/Page, key: String, value: String) -> core/Page

    @invariant AControlledAnswerIsChosenNotTyped
        -- A property whose domain the ontology governs is answered by choosing:
        -- a switch where the answer is yes or no, a list where it is one of a
        -- few, pills with completion where it is several words of a vocabulary.
        -- The corpus is the argument: `type` was asked in the open eleven times
        -- and came back with `": "` once and with five types packed into one
        -- string another. Neither is carelessness; both are what an open field
        -- does to a closed question.

    @invariant CompletionConvergesOnWhatIsAlreadySaid
        -- Completing a vocabulary answer offers what the corpus already uses,
        -- including through its alternative labels, so that someone typing
        -- `lang` is shown `language` when the two are one concept. A completion
        -- that only matched the preferred label would let the vocabulary
        -- re-fork at the exact moment it was being converged.

    @invariant ANewWordIsAcceptedAndMarked
        -- Every controlled answer also takes a word that is not in the
        -- vocabulary. It is written at once and shown as proposed. Refusing it
        -- would not produce a cleaner corpus; it would produce a corpus that
        -- stopped being annotated.

    @invariant GovernedStateIsAskedWhereItIsRead
        -- Visibility is one of the questions the header asks, in the header,
        -- among the others. It is not a badge somewhere else. A page that reads
        -- `public  false` in one place and `private` in another is telling a
        -- reader two things and giving them no way to know which governs.

    @invariant WhatIsDerivedIsNotAField
        -- Dates come from the record and are presented as readings, not as
        -- inputs. A date one can type is a date that can lie, and in a system
        -- whose premise is provenance that is not a cosmetic difference. Where
        -- the date shown is only a ceiling — the corpus's date could not be
        -- recovered and all that is known is that the page was not written
        -- after it arrived — the header says so rather than presenting the day
        -- of the import as the day of the writing.
        --
        -- La cabecera proyecta ambas lecturas con granularidad de día y con el
        -- mismo título canónico que una bitácora: `AAAA-MM-DD`. La hora precisa
        -- permanece en el registro como evidencia, pero no se impone a la lectura.
        -- Pulsar el día abre la página de bitácora que lleva ese título.

    @invariant BothHalvesOfAPropertyAreFollowable
        -- The key leads to the page that defines it and the value to the page
        -- that bears its name. Both, not one: `lang` and `es` are two questions
        -- — what this property is, and what this answer means — and a header
        -- that only follows the second leaves the first with nowhere to be
        -- asked, which is how 231 property keys came to have no definitions.
        --
        -- Following is not answering. Reaching a value's page is a different act
        -- from choosing that value, and the two must not share a target: a
        -- reader who wants to know what `proyecto` means would otherwise have to
        -- assign it to find out.

    @invariant TheControlChangesTheQuestionNotTheFile
        -- What a control writes is the same `key:: value` line the projection
        -- has always written. A redesign of the header that changed the Markdown
        -- would be a migration wearing an interface's clothes, and would have to
        -- be reviewed as one.
}

contract ResponsiveWorkspace {
    select_mobile_view: (workspace: Workspace, layout: WorkspaceLayout) -> Workspace
    open_mobile_graph_node: (workspace: Workspace, page: core/Page) -> Workspace

    @invariant SinglePaneOnNarrowScreens
        -- On a phone-sized viewport the workspace presents either text or the
        -- graph, never the split layout.

    @invariant GraphNodeOpensTextPage
        -- Selecting a graph node on a phone-sized viewport navigates to that
        -- node's page and changes the workspace to the text view.
}

contract InstallableWebApplication {
    install: () -> Workspace
    synchronise: (workspace: Workspace) -> Workspace

    @invariant ProgressiveInstallation
        -- Vera can be installed from a supporting browser and launched as an
        -- application without losing access to its web form.

    @invariant OfflineReadingAndWriting
        -- An authenticated participant can read available graph content and
        -- create or edit pages and blocks while the device has no connection.

    @invariant DeferredSynchronisation
        -- Changes made offline remain pending on that device and synchronise
        -- after connectivity returns, preserving their author and provenance.

    @invariant SingleParticipantMultiDeviceDefault
        -- The ordinary synchronisation path is optimized for one participant
        -- using the same graph from multiple devices. Concurrent conflicts are
        -- exceptional and must not burden conflict-free synchronisation.
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum WorkspaceLayout { text_only | graph_only | split }
enum GraphViewMode { graph_2d | graph_3d }
enum ColourScheme { light | dark }
enum MapContentScope { own_space | published }
enum BlockBehaviour { markdown | html | audio | video | drawing | p5js | query | mermaid | table }

-- Qué hizo alguien para llegar a la página en la que está.
--
-- No son maneras de moverse: son maneras de leer, y por eso el rastro las
-- guarda. Seguir una referencia es ir a donde el texto que se leía apuntaba;
-- entrar por un backlink es preguntar quién habló de esto; pulsar en el mapa es
-- haber visto una forma; buscar es ir a por algo que se sabía que se quería;
-- volver es regresar sobre el propio rastro; y abrir directamente es llegar sin
-- que nada de lo que se estaba leyendo lo explique — una dirección pegada, el
-- día de hoy, una página del menú.
--
-- `opened_directly` es el que se descubrió implementando y merece su nota. Es la
-- generalización de que el primer paso de un rastro sea inmotivado: se llega de
-- fuera, y el corpus no tiene nada que decir sobre por qué. Lo que se descubrió
-- es que eso no le pasa sólo al primer paso. Puede pasar en mitad de un rastro,
-- las veces que haga falta, y una lista de gestos que no lo admitiera obligaría a
-- llamar «búsqueda» a abrir el día de hoy.
--
-- Es lo único que el taller sabe y el texto no puede recuperar. Una página
-- escrita dice a qué otras nombra; no dice, ni podrá decir nunca, que su autor
-- llegó a la tercera de ellas buscando quién había hablado de la segunda. Por eso
-- se guarda aquí y sólo aquí: ver trail.allium, donde este gesto deja de ser un
-- dato y se vuelve prosa.
enum NavigationGesture {
    followed_reference | followed_backlink | pressed_on_the_map |
    searched | returned | opened_directly
}

------------------------------------------------------------
-- Entities
------------------------------------------------------------

entity Workspace {
    graph: core/Graph
    participant: core/Participant
    active_page: core/Page?
    layout: WorkspaceLayout
    split_divider_position: Decimal
    graph_view: GraphViewMode
    map_content_scope: MapContentScope
    colour_scheme: ColourScheme
    navigation_history: List<TraceStep>
    theme: Theme
}

-- Un paso del rastro: la llegada más reciente a una página.
--
-- El paso conserva cómo se llegó, pero el breadcrumb no colecciona instancias de
-- una página. Cada página aparece una sola vez. Volver a una ya presente mueve
-- ese paso al final y reemplaza su llegada anterior por la actual; no aumenta la
-- cantidad de pasos. Así el rastro dice qué páginas componen el recorrido y cuál
-- fue la llegada vigente a cada una, sin convertir cada vuelta en otro nodo.
--
-- `from` es la página desde la que se llegó, nula en el primer paso. Que el
-- primer paso no tenga origen no es una carencia que haya que rellenar: todo
-- rastro empieza con un acto que el corpus no explica.
value TraceStep {
    page: core/Page
    from: core/Page?
    gesture: NavigationGesture
    at: Timestamp
}

entity Theme {
    graph: core/Graph
    name: String
    stylesheet_source: String
    tokens: DesignToken with theme = this
}

entity DesignToken {
    theme: Theme
    name: String
    light_value: String
    dark_value: String
}

entity SearchResult {
    graph: core/Graph
    text: String
    suggestions: PageSearchSuggestion with result = this
}

-- La evidencia del índice se presenta por página, no como una fila por cada
-- bloque coincidente. Una página aparece una vez y acumula las señales que
-- explican por qué debería subir en la lista.
entity PageSearchSuggestion {
    result: SearchResult
    page: core/Page
    excerpt: String?
    internal_matches: Integer
    rank: Integer
}

entity QueryResult {
    graph: core/Graph
    expression: String
    matching_pages: Set<core/Page>
}

entity ThemeApplication {
    theme: Theme
    scheme: ColourScheme
}

-- Con qué se contesta una propiedad en la cabecera de una página.
--
-- No es una decisión de estilo: sale del dominio que la ontología declaró, y por
-- eso la interfaz no elige el control sino que lo lee. Una propiedad sin dominio
-- declarado se contesta escribiendo, y se ve que es así.
entity PropertyControl {
    page: core/Page
    key: String
    -- Nula cuando nadie ha dicho todavía con qué se contesta esta propiedad.
    -- Es el caso de casi todo el corpus importado y no es un error: es una
    -- pregunta que sigue abierta, y la cabecera puede decirlo e invitar a
    -- cerrarla.
    definition: ontology/PropertyDefinition?
    -- Lo que se ofrece ahora mismo, ya filtrado por lo que el vocabulario
    -- aprueba.
    offered: Set<String>
    -- Lo que la página contesta hoy. Puede no estar entre lo ofrecido: el corpus
    -- llegó antes que el dominio, y una discrepancia se enseña, no se corrige.
    answered: Set<String>
    governed: definition != null
    consistent: governed implies answered_within(answered, offered)
}

-- What copying a reference puts in the participant's hands. It names the block's
-- stable identity rather than its page or its position, which are exactly the two
-- things liable to change underneath it.
entity BlockReference {
    block: core/Block
    address: String
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    max_trace_steps: Integer = 50
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule ParticipantChangesWorkspaceLayout {
    when: ChangeWorkspaceLayout(participant, workspace, layout)

    requires: workspace.participant = participant

    ensures: workspace.layout = layout
}

rule ParticipantMovesSplitDivider {
    when: MoveSplitDivider(participant, workspace, position)

    requires: workspace.participant = participant

    ensures: workspace.split_divider_position = position
}

rule ParticipantChangesGraphView {
    when: ChangeGraphView(participant, workspace, graph_view)

    requires: workspace.participant = participant

    ensures: workspace.graph_view = graph_view
}

rule ParticipantReturnsToTheirOwnMap {
    when: ChangeMapContentScope(participant, workspace, scope)

    requires: workspace.participant = participant
    requires: scope = own_space

    ensures: workspace.map_content_scope = own_space
}

rule OwnerFiltersTheMapToPublishedPages {
    when: ChangeMapContentScope(participant, workspace, scope)

    requires: workspace.participant = participant
    requires: scope = published
    requires: workspace.active_page != null

    let central_publication = core/Publication{page: workspace.active_page}

    requires: exists central_publication
    requires: central_publication.site.owner = participant

    ensures: workspace.map_content_scope = published
}

rule ParticipantChangesColourScheme {
    when: ChangeColourScheme(participant, workspace, colour_scheme)

    requires: workspace.participant = participant

    ensures: workspace.colour_scheme = colour_scheme
}

rule ApplyCurrentWorkspaceTheme {
    when: ApplyTheme(participant, workspace)

    requires: workspace.participant = participant

    ensures: ThemeApplication.created(
        theme: workspace.theme,
        scheme: workspace.colour_scheme
    )
}

rule ParticipantCopiesBlockReference {
    when: CopyBlockReference(participant, workspace, block)

    requires: workspace.participant = participant

    ensures: BlockReference.created(
        block: block,
        address: block.stable_id
    )
}

rule ParticipantDiscardsEmptyBlock {
    when: DiscardEmptyBlock(participant, workspace, block)

    requires: workspace.participant = participant
    requires: block.content = ""
    requires: block.children.count = 0

    ensures: not exists block

    @guidance
        -- Emptying a block and then pressing delete once more is how a participant
        -- discards it. The block must already be empty, so the keystroke can never
        -- take text with it, and it must be a leaf, which is the same condition
        -- remove_block carries in change-application.allium. Under this empty-block
        -- keystroke, a block with children stays until its children are gone; the
        -- explicit subtree discard below is a separate, confirmed act.
}

rule ParticipantDiscardsBlockSubtree {
    when: DiscardBlockSubtree(participant, workspace, block, confirmed_descendant_count)

    let descendants = descendants_of(block)

    requires: workspace.participant = participant
    requires: descendants.count > 0
    requires: confirmed_descendant_count = descendants.count

    ensures:
        for descendant in descendants:
            not exists descendant
        not exists block

    @guidance
        -- The confirmation belongs to the exact subtree the participant saw.
        -- Submit one ordinary remove_block change per block, from the deepest
        -- leaves towards the root, so every accepted change still removes a leaf
        -- and an interrupted sequence can never leave an orphan behind.
}

rule ParticipantNavigatesToPage {
    when: NavigateToPage(participant, workspace, page, gesture)

    requires: workspace.participant = participant
    requires: page.graph = workspace.graph

    ensures:
        workspace.active_page = page
        workspace.navigation_history = latest(
            append(without_page(workspace.navigation_history, page),
            TraceStep{
                page: page,
                from: workspace.active_page,
                gesture: gesture,
                at: now
            }),
            config.max_trace_steps
        )

    @invariant TheGestureIsObservedAndNeverInferred
        -- El gesto lo pone la superficie que lo recibió, porque es la única que
        -- lo sabe. Vera no lo deduce después mirando si existía una referencia
        -- entre las dos páginas: eso contestaría qué había en el corpus, y la
        -- pregunta es qué hizo alguien. Las dos cosas se separan a propósito y
        -- pueden discrepar — ver trail.allium.
        --
        -- De lo que se sigue que no hay gesto por defecto. Un sitio que no sepa
        -- decir cómo se llegó no puede poner un paso en el rastro, y eso es la
        -- garantía y no una molestia: el día que alguien añada una forma nueva de
        -- abrir una página, el rastro no se llena de pasos que dicen «se llegó de
        -- alguna manera».

    @invariant RedrawingAPageIsNotWalkingToIt
        -- Volver a dibujar la página en la que ya se está —porque se guardó algo,
        -- porque cambió el foco, porque se colocó un audio— no es navegar y no
        -- deja paso. Un rastro que contara los redibujados diría dónde estuvo el
        -- programa, no dónde estuvo quien lee.
        --
        -- Navegar de vuelta a una página que ya está en el rastro sí es moverse,
        -- pero tampoco crea otra instancia: actualiza su llegada y la mueve al
        -- final. Redibujar no hace siquiera eso, porque no hubo navegación.

    @invariant RevisitingReordersInsteadOfRepeating
        -- Antes de agregar la llegada, se quita del breadcrumb cualquier paso de
        -- la misma página. El paso nuevo queda al final con el gesto y el origen
        -- actuales. Una revisita cambia el orden y la llegada conservada; nunca
        -- cambia el número de páginas del breadcrumb.
}

rule ParticipantOpensGraphNodeOnPhone {
    when: OpenMobileGraphNode(participant, workspace, page)

    requires: workspace.participant = participant
    requires: page.graph = workspace.graph

    ensures:
        workspace.active_page = page
        workspace.layout = text_only
        workspace.navigation_history = latest(
            append(without_page(workspace.navigation_history, page),
            TraceStep{
                page: page,
                from: workspace.active_page,
                gesture: pressed_on_the_map,
                at: now
            }),
            config.max_trace_steps
        )
}

rule ParticipantClearsTheTrace {
    when: ClearTrace(participant, workspace)

    requires: workspace.participant = participant

    ensures: workspace.navigation_history = []
}

-- Quitar un paso del rastro.
--
-- Se anda por sitios a los que no se iba: la página que se abrió por error, la
-- que resultó no ser lo que su título prometía, el rodeo para comprobar una
-- fecha. Un rastro que no se puede podar obliga a que todo eso llegue al
-- argumento, y entonces lo primero que se hace con un argumento recién nacido es
-- limpiarlo, que es la peor manera de empezar a pensar.
rule ParticipantDropsATraceStep {
    when: DropTraceStep(participant, workspace, step)

    requires: workspace.participant = participant
    requires: workspace.navigation_history.any(s => s = step)

    ensures:
        workspace.navigation_history = without(workspace.navigation_history, step)

    @invariant DroppingAStepLeavesNoRecord
        -- No queda constancia de que ese paso estuvo. El rastro no tiene historia
        -- porque no es una página: es dónde está uno, y dónde estuvo uno hace diez
        -- minutos y ya no quiere contar no es asunto de nadie.
        --
        -- Es lo contrario de lo que ocurre en cuanto el rastro se promueve, y la
        -- diferencia es deliberada. Ver trail/PruningIsEditingOnceItIsAPage.
}

-- Reordenar el rastro.
--
-- Y aquí el rastro deja de ser sólo un registro. Mientras nadie lo toca dice por
-- dónde se anduvo; en cuanto alguien arrastra un paso, dice por dónde alguien
-- quiere que se lea. Son dos cosas y conviven en un mismo objeto, que es
-- exactamente lo que hace falta: componer un argumento empieza mucho antes de
-- decidir que se está componiendo uno.
rule ParticipantReordersTheTrace {
    when: ReorderTraceStep(participant, workspace, step, position)

    requires: workspace.participant = participant
    requires: workspace.navigation_history.any(s => s = step)
    requires: position >= 0
    requires: position < workspace.navigation_history.count

    ensures:
        workspace.navigation_history = moved_to(workspace.navigation_history, step, position)

    @invariant ReorderingDoesNotRewriteWhatHappened
        -- Un paso arrastrado conserva su gesto y la página desde la que se llegó a
        -- él, que son hechos sobre lo que ocurrió y no cambian porque el paso
        -- cambie de sitio. Lo que cambia es de quién es vecino.
        --
        -- Con lo cual las dos cosas pueden discrepar: un paso puesto en tercer
        -- lugar puede recordar que se llegó a él desde una página que ahora está
        -- la séptima. No es un error que reparar y no se repara. Es la distancia
        -- entre por dónde se anduvo y por dónde se quiere llevar a alguien, que es
        -- justamente lo que un argumento añade a un paseo.

    @invariant TheTraceKeepsAccumulatingWhileItIsBeingArranged
        -- Ordenar el rastro no lo cierra ni lo congela. Se sigue navegando y los
        -- pasos nuevos siguen llegando al final, junto a los que ya se colocaron.
        -- Nadie tiene que terminar de componer para volver a leer, que es el orden
        -- en que esto ocurre de verdad: se lee, se ve una forma, se mueve una
        -- pieza, se sigue leyendo.
}

rule ParticipantEditsThemeSource {
    when: EditThemeSource(participant, workspace, stylesheet_source)

    requires: workspace.participant = participant

    ensures: workspace.theme.stylesheet_source = stylesheet_source
}

rule ParticipantEditsDesignToken {
    when: EditDesignToken(participant, workspace, token, light_value, dark_value)

    requires: workspace.participant = participant
    requires: token.theme = workspace.theme

    ensures:
        token.light_value = light_value
        token.dark_value = dark_value
}

-- Preguntarle a una página lo que se le pregunta a toda página.
--
-- El orden es fijo y las cuatro primeras están siempre, contestadas o no: qué es,
-- de qué trata, cuándo se escribió y cuándo se tocó por última vez. Después, lo
-- que esa página además lleve. Ver controlled-ontology/TheSameQuestionsOpenEveryPage.
rule PresentPageFrontMatter {
    when: OpenPageFrontMatter(participant, workspace, page)

    requires: workspace.participant = participant
    requires: page.graph = workspace.graph

    ensures:
        for key in front_matter_keys(page):
            PropertyControl.created(
                page: page,
                key: key,
                definition: governing_definition(workspace.graph, page, key),
                offered: offered_values(workspace.graph, page, key),
                answered: answered_values(page, key)
            )

    @guidance
        -- governing_definition devuelve nulo cuando nadie ha declarado con qué se
        -- contesta esa propiedad, que hoy es casi todo el corpus. No es un fallo
        -- que haya que resolver antes de dibujar la cabecera: es el estado
        -- normal de un corpus heredado, y la cabecera tiene que saber leerlo sin
        -- perder la diferencia entre una pregunta sin gobierno y una sin
        -- contestar.
}

rule ParticipantSearchesGraph {
    when: SearchGraph(participant, workspace, text)

    requires: workspace.participant = participant

    ensures:
        let result = SearchResult.created(
            graph: workspace.graph,
            text: text
        )
        for suggestion in page_search_suggestions(workspace.graph, text, participant):
            PageSearchSuggestion.created(
                result: result,
                page: suggestion.page,
                excerpt: suggestion.excerpt,
                internal_matches: suggestion.internal_matches,
                rank: suggestion.rank
            )
}

rule ParticipantQueriesGraph {
    when: QueryGraph(participant, workspace, expression)

    requires: workspace.participant = participant

    ensures: QueryResult.created(
        graph: workspace.graph,
        expression: expression,
        matching_pages: query_pages(workspace.graph, expression, participant)
    )
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant WorkspaceUsesThemeFromItsGraph {
    for workspace in Workspaces:
        workspace.theme.graph = workspace.graph
}

invariant ActivePageBelongsToWorkspaceGraph {
    for workspace in Workspaces:
        workspace.active_page != null implies workspace.active_page.graph = workspace.graph
}

invariant TraceRemainsBounded {
    for workspace in Workspaces:
        workspace.navigation_history.count <= config.max_trace_steps
}

invariant TraceContainsEachPageOnce {
    for workspace in Workspaces:
        for a in workspace.navigation_history:
            for b in workspace.navigation_history:
                a != b implies a.page != b.page
}

invariant SearchSuggestionsBelongToTheirGraph {
    for suggestion in PageSearchSuggestions:
        suggestion.page.graph = suggestion.result.graph
}

invariant SearchSuggestsEachPageOnce {
    for a in PageSearchSuggestions:
        for b in PageSearchSuggestions:
            a != b and a.result = b.result implies a.page != b.page
}

invariant SearchSuggestionRanksAreUnique {
    for a in PageSearchSuggestions:
        for b in PageSearchSuggestions:
            a != b and a.result = b.result implies a.rank != b.rank
}

invariant SearchSuggestionCountsAreNonNegative {
    for suggestion in PageSearchSuggestions:
        suggestion.internal_matches >= 0
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

actor WorkspaceParticipant {
    within: Workspace
    identified_by: core/Participant where core/Membership{graph: within.graph, participant: this}.status = active
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface VeraWorkspace {
    facing participant: WorkspaceParticipant
    context workspace: Workspace

    exposes:
        workspace.graph.name
        workspace.active_page
        workspace.layout
        workspace.split_divider_position
        workspace.graph_view
        workspace.map_content_scope
        workspace.colour_scheme
        workspace.navigation_history
        workspace.theme

    provides:
        ChangeWorkspaceLayout(participant, workspace, layout)
        MoveSplitDivider(participant, workspace, position)
        ChangeGraphView(participant, workspace, graph_view)
        ChangeMapContentScope(participant, workspace, scope)
        ChangeColourScheme(participant, workspace, colour_scheme)
        ApplyTheme(participant, workspace)
        NavigateToPage(participant, workspace, page, gesture)
        DropTraceStep(participant, workspace, step)
        ReorderTraceStep(participant, workspace, step, position)
        ClearTrace(participant, workspace)
        OpenPageFrontMatter(participant, workspace, page)
        OpenMobileGraphNode(participant, workspace, page)
        EditThemeSource(participant, workspace, stylesheet_source)
        EditDesignToken(participant, workspace, token, light_value, dark_value)
        SearchGraph(participant, workspace, text)
        QueryGraph(participant, workspace, expression)

    contracts:
        fulfils GraphQuerySupport
        fulfils EditablePresentation
        fulfils NativeMarkdownEditing
        fulfils BlockBehaviourPresentation
        fulfils BlockManipulation
        fulfils PageFrontMatter
        fulfils ResponsiveWorkspace
        fulfils InstallableWebApplication

    @guarantee NavigableGraphContext
        -- Text and graph views share the same active page and navigation history.
        -- Changing layout does not discard the participant's place in the graph.

    @guarantee RememberedSessionPresentation
        -- Split view begins evenly divided for a participant with no saved
        -- preference. Subsequent divider position, light or dark colour scheme
        -- and edited design tokens are retained for that participant — not for
        -- the browser they happened to use. What someone tuned to their own eye
        -- is theirs, and having to tune it again on the next machine would say
        -- it belongs to the machine.
        --
        -- The typefaces Vera offers travel with Vera as files, so a corpus read
        -- on a phone renders as it did on the desk. The remaining choices name
        -- the system's own faces on purpose: those are meant to differ per
        -- device, and resolving them differently is them working.

    @guarantee PresentationSurvivesTheServer
        -- Presentation is read and drawn from what the device already holds, and
        -- reconciled with what is remembered afterwards. Opening Vera never
        -- waits on the network to know what colour it is, and a Vera whose
        -- server is unreachable still looks like itself.

    -- El eje: de lo general a lo particular, de izquierda a derecha.
    @guarantee TheMapIsBeforeTheText
        -- The map occupies the side a reader begins from and the text the side
        -- they end at. Entering a document is a movement inward, and the reading
        -- direction is what tells a hand which way that is. The map is where one
        -- is located; the text is where one is.

    @guarantee TodayIsWhereWritingBegins
        -- The workspace opens on the day in progress, and reaching it costs one
        -- gesture from anywhere. Nothing has to be named or created before
        -- writing: naming a thought is a judgement about it, and requiring that
        -- judgement first is how thoughts go unwritten. See daily-log.allium.

    @guarantee EditableDesignSystem
        -- General styles and design tokens are editable from within Vera and
        -- remain accessible as source rather than opaque application state.

    @guarantee ResponsiveSinglePaneNavigation
        -- Narrow screens offer text or graph as exclusive views. Choosing a
        -- graph node opens its page in the text view.

    -- Lo que el mapa debe llegar a ofrecer. Está dicho aquí, y no en una lista
    -- de tareas aparte, porque es comportamiento exigible y no trabajo
    -- pendiente: una lista de tareas se cierra, una garantía se cumple.

    @guarantee TheMapCarriesItsOwnControls
        -- What governs the map — its dimension, its reach, its trace — belongs
        -- in the map and not in a bar shared with everything else. A control
        -- placed away from what it governs makes a reader learn a mapping that
        -- the layout could have told them.

    @guarantee PublishedIsAMapFilterNotAnIdentity
        -- In the authenticated PWA, the eye/map panel offers `Mi espacio` and
        -- `Publicado`. Changing that choice filters the owner's map and workspace
        -- context locally; the participant, credential and authority do not
        -- change, and no `anybody` session is created.

    @guarantee PublishedStartsFromAPublishedCentre
        -- `Publicado` is available only while the central page is an explicit
        -- Publication of a site owned by the participant. Its map is the induced
        -- subgraph of that site's Publications reachable from the central page
        -- within the map's current reach; private and unassigned pages are absent.

    @guarantee PublishedKeepsTheOwnersTools
        -- Filtering to `Publicado` removes nodes from the map, not capabilities
        -- from the owner. Every published page shown there remains readable and
        -- editable through the same authenticated workspace, with ordinary
        -- attributed operations.

    @guarantee MapScopeIsLocalWorkspaceState
        -- `Mi espacio` or `Publicado` changes no Page, Publication, Membership,
        -- credential, revision or operation. Returning to `Mi espacio` restores
        -- the owner's ordinary reachable graph without authentication.

    @guarantee TheMapCanStepAside
        -- The map can be collapsed and brought back without losing where one is.
        -- A pane that is always there is furniture; one that can leave is a
        -- tool. It returns at the width it had and looking at what it was
        -- looking at.

    @guarantee TheMapHoldsItsPositions
        -- Where a node sits is computed when the set of nodes changes, and not
        -- again. Collapsing the map, resizing it, changing pages within the same
        -- neighbourhood or repainting leave every node where it was.
        --
        -- This is not only about cost, though the cost is real and shows up as
        -- lag on a corpus of this size. A map that rearranges itself while one
        -- looks at it cannot be remembered, and a map one cannot remember is a
        -- picture rather than a place. Recognising a region by its shape is the
        -- whole reason for drawing it.

    @guarantee TheTraceIsWhereOneIsLocated
        -- Where a participant has been accumulates visibly, and any step of it
        -- can be returned to directly. It belongs with the map, because that is
        -- the surface for knowing where one stands.
        --
        -- It is a trace and not a trail, and the distinction is the whole of
        -- trail.allium. A trace is the mark one leaves without meaning to:
        -- automatic, private, authorless, and about oneself. A trail is the route
        -- one draws on purpose, for somebody else, and it is an argument. They are
        -- the same object at two moments, and the second begins when someone looks
        -- at where they have been and decides that it was saying something.

    @guarantee TheTraceRemembersHowAndNotOnlyWhere
        -- Each step keeps the gesture that produced it, and that is the one thing
        -- the workspace knows which no text can ever recover. A page says which
        -- others it names; nothing in it says that its author reached the third of
        -- them by asking who had spoken about the second.
        --
        -- It is kept because it is perishable. A crossing's other face — whether
        -- the corpus had a sentence joining those two pages — can be recomputed at
        -- any moment from the graph, so there is no reason to store it. The gesture
        -- can be recomputed never. Vera stores what would otherwise be lost and
        -- derives what would otherwise be duplicated, and the two faces of a
        -- crossing fall on opposite sides of that line.

    @guarantee TheTraceIsArrangeableWhereItIsSeen
        -- Los pasos del rastro se arrastran para reordenarlos y se quitan uno a
        -- uno, en el mapa, donde están. No hay un modo de edición del rastro ni una
        -- ventana aparte donde componerlo: se toca lo que se está mirando.
        --
        -- Ordenar el rastro es la primera mitad de componer un argumento y ocurre
        -- antes de que nadie haya decidido componer ninguno. Por eso vive aquí y
        -- no en trail.allium: es una cosa que se hace mientras se lee.

    @guarantee TheTraceSurvivesRefresh
        -- El rastro completo sobrevive a recargar o cerrar la interfaz. La última
        -- parada sigue siendo donde el participante está. Regresar al taller
        -- devuelve la secuencia única de páginas que se estaba componiendo, con
        -- sus podas y orden manual. Si una versión anterior guardó duplicados, al
        -- abrir se conserva sólo la llegada más reciente de cada página.
        --
        -- Esta durabilidad no convierte el rastro en corpus. Sigue siendo estado
        -- privado del taller, sin página, autor ni historial de revisiones; sólo
        -- deja de depender de que una pestaña permanezca abierta. Promoverlo sigue
        -- siendo el gesto que lo vuelve texto compartible y auditable.

    @guarantee TheTraceIsBoundedAndClearable
        -- El rastro conserva hasta un límite visible de páginas únicas del taller
        -- y ofrece un gesto para vaciarlo entero. Limpiarlo no borra
        -- páginas ni recorridos ya promovidos: sólo descarta el rastro privado de
        -- este dispositivo, sin dejar un historial de lo descartado.

    @guarantee PromotingIsOneSmallGesture
        -- El rastro lleva una sola marca para promoverlo, discreta, con su nombre
        -- en un tooltip y no escrito al lado. Pulsarla no abre un diálogo, no pide
        -- un título y no pregunta nada: sale una página, y lo que hay que decidir
        -- se decide escribiéndola.
        --
        -- Discreta a propósito. Lo que hay detrás de esa marca es grande —de aquí
        -- sale un texto que puede acabar publicado y en manos de otro— y una
        -- marca que anunciara ese tamaño haría que se pulsara sólo cuando alguien
        -- ya estuviera seguro de tener algo que decir. Justo al revés de como
        -- pasa: uno pulsa porque le pareció que quizá había algo ahí, y se entera
        -- de si lo había al escribirlo.

    @guarantee TheTraceKeepsItsGestureAndNotItsReason
        -- What is recorded is what someone did, not what they meant by it. A
        -- gesture is checkable, is about the walker, and was performed; a reason is
        -- an assertion about the corpus, and Vera has no standing to make one.
        --
        -- The whole of trail.allium rests on this line holding here, at the cheap
        -- end, where nothing has been claimed yet.

    @guarantee TheMapIsBoundedByReach
        -- How much of the graph a map shows is the participant's to set, from
        -- the neighbours of the page in focus outward. A map of everything at
        -- once shows nothing: the corpus is large enough that the whole of it is
        -- a texture, not a picture.
        --
        -- The unit is hops: distance along the links, literally. Not a count of
        -- nodes and not a strength — those would answer "how much fits" and the
        -- question a reader is asking is "how far from here", which is a fact
        -- about the graph rather than about the screen.
        --
        -- And because the unit is hops, the control changes it one hop at a
        -- time and shows which hop one is on. A slider is the instrument of a
        -- continuous magnitude; reach is three whole numbers, and asking a
        -- reader to aim at one of them says "how much" where the answer is a
        -- count.
        --
        -- Three and not more. A neighbourhood grows with the branching factor
        -- raised to the reach, so the hop that turns a picture into a texture
        -- arrives early. Past the third the map has stopped answering "what is
        -- near this" and started answering "what is there", which is the map of
        -- everything this guarantee exists to refuse.

    @guarantee OneCompletionOverEverythingNamed
        -- What the search field completes against is titles, blocks and tags
        -- together, ranked as one list. A participant looking for something
        -- knows what they are looking for, not which of Vera's indexes holds it,
        -- and three separate fields would make them guess.
        --
        -- Completing inside a block is a different act and stays different:
        -- there the vocabulary is already settled by the delimiter typed —
        -- `[[` names a page, `#` a tag, `((` a block — and offering everything
        -- would undo a choice the participant already made.

    @guarantee SearchEvidenceCollapsesToOneSuggestionPerPage
        -- A page appears once even when its title, several blocks, properties or
        -- glosas match. Internal matches are counted and make the page rise; an
        -- exact title remains the strongest signal. The suggestion keeps one
        -- excerpt and the count, so collapsing repetition does not hide why the
        -- page was offered.

    @guarantee AVocabularyValueIsReachableFromWhereItIsAnswered
        -- Beside a controlled answer there is a way to the page that bears its
        -- name, where what that word means can be written and where every page
        -- answering with it is listed. The value in a header is the near end of
        -- a link; a value one can read but not follow makes the vocabulary a
        -- label instead of a place.
        --
        -- Not the eye. That mark already means folding the map's controls in
        -- this workspace, and a mark that means two things means neither.

    @guarantee AVocabularyPageReadsAsListSearchAndRoomToWrite
        -- A page whose name the vocabulary uses presents three things in one
        -- order: what one has written on it, at the top and editable as any
        -- blocks are; then the pages that classify with it or define it; and a
        -- search bounded to that set.
        --
        -- Writing first because the page belongs to whoever writes it, not to
        -- the index. A definition of what `proyecto` means in this corpus is
        -- worth more than the list of them, and putting the list first would say
        -- the opposite — that the page is a report one may annotate rather than
        -- a page that happens to know something.
        --
        -- The search is bounded and is not a second mechanism: it composes the
        -- standing expression with a text term, exactly as
        -- query-language/SearchingWithinAResultIsComposition sets out.

    @guarantee FollowingAMissingNameLandsInItsFirstBlock
        -- Pressing a reference to a page that does not exist opens that page
        -- with the caret in its first empty block. No dialog, no confirmation,
        -- nothing pre-written. See graph-navigation.allium, where the change
        -- itself is governed.

    @guarantee GraphNodesAreTheirNames
        -- A node in the map is the text of what it names, not a circle beside
        -- it. The name is the thing a reader is looking for, and a mark that
        -- carries no name spends the same space saying less. In two dimensions
        -- names must not overlap each other: two names on top of one another is
        -- neither of them.

    @guarantee TheMapArrivesFramed
        -- A map that is drawn is a map that can be seen whole. When the map is
        -- first shown, and whenever it is asked to centre itself, every node in
        -- it falls within view, at a size at which its name can be read.
        --
        -- What is framed is what is drawn, and not where it is drawn. This is
        -- the distinction the guarantee exists to hold, because it is the one
        -- that has been lost repeatedly: since GraphNodesAreTheirNames makes a
        -- node its name, a node occupies the space of a word and not of a point.
        -- A framing computed from node coordinates measures a graph of one node
        -- as having no size at all, and puts the camera inside the word — which
        -- shows as an empty map, or as a single letter filling the panel. In
        -- three dimensions there is no recovering from that by hand: the reader
        -- is inside the thing they were meant to be looking at.
        --
        -- Framing is subordinate to intent. Once a reader has moved the view,
        -- the map does not reframe itself; it returns to where they left it,
        -- as TheMapHoldsItsPositions requires of the layout.
}

------------------------------------------------------------
-- Deferred Specifications
------------------------------------------------------------

deferred GraphRendering.present -- see: graph-rendering.allium
deferred QueryLanguage.execute   -- see: query-language.allium
deferred SearchIndex.find        -- see: search-index.allium
deferred BlockGloss.present       -- see: block-gloss.allium

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "When edited style source is invalid, should Vera reject it or keep it with the last valid presentation active?"
-- Preview is no longer open: rendered presentation is required, and its shape is
-- fixed by RenderedPresentationIsFaithful and EditingRevealsTheSource above.
-- Contestadas: negrita y cursiva conservan los atajos nativos del sistema; las
-- notas se escriben como Markdown portable y se resuelven sobre la página
-- compuesta, aunque referencia y definición vivan en bloques distintos. Ver
-- FamiliarFormattingKeysEditMarkdown, FootnotesRemainEditable y
-- FootnotesAreARoundTrip.
-- Contestadas: la unidad del alcance son los saltos, el autocompletado va contra
-- todo junto y ordenado, y el mapa vuelve como estaba. Ver las garantías
-- TheMapIsBoundedByReach, OneCompletionOverEverythingNamed y TheMapHoldsItsPositions.
open question "Does moving to another page keep the reach that was set, or return to a default — and if it keeps it, what happens when the new page's neighbourhood at that reach is far larger than the last one's?"
open question "A block with no text keeps the height of one line so it can be aimed at. Does an empty block also deserve to be visible as such in the map and in the Markdown mirror, or is an empty block a thing that only the editor should know about?"
